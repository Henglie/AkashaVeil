struct LocaleTable { const wchar_t* code; const wchar_t* const* text; const wchar_t* const* strings; };
static constexpr LocaleTable locale_tables[] = {
    {L"es", locale_es_text, locale_es_strings},
    {L"fr", locale_fr_text, locale_fr_strings},
    {L"ru", locale_ru_text, locale_ru_strings},
    {L"ar", locale_ar_text, locale_ar_strings},
    {L"tr", locale_tr_text, locale_tr_strings},
    {L"ja", locale_ja_text, locale_ja_strings},
    {L"ko", locale_ko_text, locale_ko_strings},
};
static const wchar_t* const* locale_table(const std::wstring& language, bool strings) {
    for (const auto& table : locale_tables) {
        if (language == table.code) return strings ? table.strings : table.text;
    }
    return nullptr;
}
